# ==============================================================================
# Warehouse Temperature Report - Environment Variables Example
# Sediakan nilai pada Vercel Dashboard (Project Settings > Environment Variables)
# JANGAN PERNAH MENYIMPAN NILAI RAHASIA KE DALAM FILE INI ATAU KE GIT REPOSITORY!
# ==============================================================================

# Google Service Account (dari file JSON Service Account Google Cloud)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Google Sheets & Google Drive
GOOGLE_SHEET_ID=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Sesi & Keamanan Login (Minimal 32 karakter acak)
JWT_SECRET_KEY=

# WhatsApp Gateway Fonnte
FONNTE_API_TOKEN=
FONNTE_WA_GROUP_ID=

# Kunci Sementara Inisialisasi /api/init (Wajib dihapus dari Vercel setelah selesai)
SETUP_KEY=
